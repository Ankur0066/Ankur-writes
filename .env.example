# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=changeme
DB_NAME=blog_db

# JWT
JWT_SECRET=replace_this_with_a_strong_secret
JWT_EXPIRES_IN=1h

# ImgBB
IMGBB_API_KEY=replace_with_your_imgbb_key

# SMTP (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# Bootstrap admin (optional) - keep private
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=securepassword

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
